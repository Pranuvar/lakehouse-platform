# Copy this file to .env before running `docker compose up`.
# Every credential here is a local-only dev default -- fine to commit as an
# example file, NOT fine to reuse anywhere real. .env itself is gitignored.

# ---- Postgres (OLTP source + Airflow metadata DB, one instance / two DBs) ----
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse_dev_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_OLTP_DB=oltp
POSTGRES_AIRFLOW_DB=airflow

# ---- MinIO (S3-compatible object storage: flat-file drops + Delta lake) ----
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse_dev_pw
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
# buckets: raw-dropzone (messy flat files), lakehouse (bronze/silver/gold Delta)
MINIO_BUCKET_DROPZONE=raw-dropzone
MINIO_BUCKET_LAKEHOUSE=lakehouse

# ---- Redpanda (Kafka-API-compatible broker for the event stream) ----
# In-network address (used by Airflow/Spark containers). Host-side tools
# (seeders, a local kcat/Kafka UI) use localhost:19092 instead -- see the
# `external` listener in docker-compose.yml.
REDPANDA_BROKER=redpanda:9092
REDPANDA_TOPIC_EVENTS=web.clickstream.events

# ---- Mock REST API (paginated, rate-limited campaign performance source) ----
MOCK_API_PORT=8000
# 60/min is a realistic third-party-API limit and the retry/backoff logic
# in ingestion/pipelines/rest_api_campaigns.py is written to respect
# whatever this is set to -- turned up here purely so a full ~2,190-page
# historical sync finishes in minutes instead of ~36 during local dev/
# demo iteration. Drop back to a real vendor's documented limit (or lower)
# to see the pipeline spend most of its time legitimately rate-limited.
MOCK_API_RATE_LIMIT_PER_MIN=600
MOCK_API_KEY=dev-local-key-do-not-use-in-prod

# ---- Airflow ----
# MUST match your host user's UID (`id -u`) -- dags/logs/plugins are bind
# mounts, and Airflow's container user needs write access to them on the
# host side, not just inside the container. 50000 is upstream Airflow's
# own default and works IF your host UID happens to be 50000; if not
# (the common case), override it, e.g. `echo "AIRFLOW_UID=$(id -u)" >> .env`.
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=IJ4Q8dJ1u4W4Zt3hqzGxJ6b3nZ0hY7Xx8pV6c1v4qk0=
AIRFLOW_WEBSERVER_PORT=8080

# ---- dbt warehouse target ----
# local | snowflake  (local = DuckDB file, no cloud dependency)
DBT_TARGET=local

# Snowflake is OPTIONAL and only read when DBT_TARGET=snowflake. Leave blank
# for the free local build -- see docs/BUILD_LOG.md for the migration story.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
